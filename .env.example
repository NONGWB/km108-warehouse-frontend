NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Used only by `npm run auth:create-admin`; desktop packaging explicitly excludes it.
# Never prefix this key with NEXT_PUBLIC_. Remove it after the first admin is created if preferred.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
